# Database Configuration
# SQLite file database — no server needed. Path is relative to the project root.
SQLITE_DB_PATH=./data/sqlite.db

# Session Secret (for Express sessions)
SESSION_SECRET=your-secret-key-change-this-in-production

# Email Configuration
# Email address to receive contact form submissions
CONTACT_EMAIL=firstlinkconsultingllc@gmail.com

# Gmail SMTP Configuration
# To use Gmail, you need to:
# 1. Enable 2-factor authentication on your Google account
# 2. Generate an "App Password" at https://myaccount.google.com/apppasswords
# 3. Use your Gmail address and the app password below
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=firstlinkconsultingllc@gmail.com
EMAIL_PASSWORD=your-app-password-here
ADMIN_PASSWORD=Billiyapura@Derol